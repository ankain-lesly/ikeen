// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth Model - Handles authentication and credentials
model Auth {
  id         String   @id @default(uuid())
  userId     String   @unique
  type       AuthType @default(password)
  provider   String   @default("self") @db.VarChar(50)
  providerId String?  @db.VarChar(255)

  password String? @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth")
}

enum AuthType {
  password
  phone
  magicLink
}

// User related models
model User {
  id        String   @id @default(uuid())
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  type      UserType @default(user)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  avatarUrl String? @db.VarChar(500)
  lastLogin   DateTime? @default(now())
  dateOfBirth DateTime?
  gender      String?   @db.VarChar(20)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    ModelStatus @default(active)
  
  currency  String   @default("XAF") @db.VarChar(4)

  // Relations
  auth                Auth?
  verificationTokens  VerificationToken[]
  pushTokens          PushToken[]
  auditLogs           AuditLog[]
  folders             Folder[]
  notes               Note[]
  syncLogs            SyncLog[]
  chatConversations   ChatConversation[]
  chatMemories        ChatMemory[]
  apiKeys             ApiKey[]
  @@map("users")
}

enum UserType {
  user
  admin
}

enum VerificationMethod {
  token
  otp
  code
  link
}

enum VerificationType {
  email_verification
  phone_verification
  password_reset
  two_factor_auth
  passwordless_login
  email_change
  account_deletion
  subscription_confirmation
}

enum IdentifierType {
  email
  phone
}

enum VerificationStatus {
  pending
  verified
  expired
  cancelled
}

model VerificationToken {
  id String @id @default(cuid())

  userId String?

  identifier     String                 @db.VarChar(255)
  identifierType IdentifierType

  type   VerificationType
  method VerificationMethod @default(code)

  status VerificationStatus @default(pending)

  tokenHash String    @db.VarChar(255)
  attempts  Int       @default(0)
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.Text
  device    String?   @db.VarChar(100)

  expiresAt   DateTime
  verifiedAt  DateTime?
  cancelledAt DateTime?
  lastSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, type])
  @@index([identifier, status])
  @@index([expiresAt])
  @@map("verification_tokens")
}



// =====================================
// AUDIT LOG MODEL
// =====================================


// ============= AUDIT LOG SYSTEM =============

model AuditLog {
  id String @id @default(cuid())

  // Universal user tracking (works for ALL user types)
  userId String?
  //userType UserType?

  // Action details
  action   String        @db.VarChar(100)
  severity AuditSeverity @default(INFO)
  isSystem Boolean       @default(false)

  // Resource tracking
  resourceType String? @db.VarChar(100)
  resourceId   String? @db.VarChar(100)

  // Change tracking
  metadata Json?
  changes  Json?
  details  String? @db.Text

  // Request context
  ipAddress     String? @db.VarChar(45)
  userAgent     String? @db.Text
  requestPath   String? @db.VarChar(255)
  requestMethod String? @db.VarChar(10)

  // Status
  success      Boolean @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  // Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([userId, createdAt])
  @@index([action, severity])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

enum AuditSeverity {
  INFO // Regular operations (view, list)
  WARN // Important changes (update, delete)
  ERROR // Failed operations
  CRITICAL // Security-relevant actions (permission changes, staff removal)
}

// =====================================
// NOTIFICATION MODEL
// =====================================

model Notification {
  id String @id @default(cuid())

  userId String

  userType UserType

  isSystem Boolean @default(false)

  // Content
  title    String               @db.VarChar(255)
  message  String               @db.Text
  type     NotificationType     @default(general)
  priority NotificationPriority @default(default)
  platform NotifyPlatformType   @default(web)

  // Delivery channels
  channel NotificationChannel @default(default)
  sentAt  DateTime?

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Metadata
  data      Json? // Additional context data
  link      String? @db.VarChar(255) // Deep link or action url
  linkLabel String? @db.VarChar(100) // Deep link or action url

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId, userType])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model PushToken {
  id     String @id @default(cuid())
  userId String

  // Device Type
  platform NotifyPlatformType // web or mobile

  token String @unique @db.VarChar(500)

  // Device Metadata
  deviceName   String? @db.VarChar(100)
  deviceId     String? @db.VarChar(100) // Device identifier for tracking
  osVersion    String? @db.VarChar(50) // OS version
  appVersion   String? @db.VarChar(50) // App version
  manufacturer String? @db.VarChar(100) // Device manufacturer (e.g., Apple, Samsung)
  model        String? @db.VarChar(100) // Device model (e.g., iPhone 14, Galaxy S23)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("push_tokens")
}

enum NotificationChannel {
  default
  email
  push
  sms
}

// Notification types for different events in the system
enum NotificationType {
  order
  delivery
  payment
  general
  // ... more types can be added here
}

enum NotificationPriority {
  default
  normal
  high
}

enum NotifyPlatformType {
  web
  ios
  android
}

// ENUMS
// =====================================
enum ModelStatus {
  pending
  inactive
  active
  deleted
  achieved
}

// =====================================
// SYNC ENGINE: FOLDERS & NOTES
// =====================================

model Folder {
  id        String    @id @default(uuid())
  userId    String
  name      String    @default("") @db.VarChar(100)
  color     String    @default("#3b82f6") @db.VarChar(30)
  icon      String    @default("folder") @db.VarChar(50)
  isLocked  Boolean   @default(false)
  pinCode   String?   @db.VarChar(20)
  sortOrder Int       @default(0)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("folders")
}

model Note {
  id         String    @id @default(uuid())
  userId     String
  folderId   String?
  title      String    @default("") @db.VarChar(255)
  content    String    @default("") @db.Text
  tags       String[]  @default([])
  isPinned   Boolean   @default(false)
  isArchived Boolean   @default(false)
  summary    String?   @db.Text
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@index([userId, folderId])
  @@map("notes")
}

enum SyncEntity {
  folders
  notes
}

model SyncLog {
  id         String     @id @default(uuid())
  userId     String
  mutationId String     @db.VarChar(150)
  entity     SyncEntity
  entityId   String     @db.VarChar(100)
  action     String     @db.VarChar(20)
  version    Int        @default(1)
  status     String     @default("applied") @db.VarChar(20)
  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mutationId])
  @@index([userId, entity, entityId])
  @@map("sync_logs")
}

// =====================================
// CHAT PERSISTENCE SYSTEM
// =====================================

model ChatConversation {
  id                String   @id @default(cuid())
  userId            String
  title             String?  @db.VarChar(255)
  composioSessionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         ChatMessage[]
  memories         ChatMemory[]
  conversationData ChatConversationData[]

  @@index([userId, updatedAt])
  @@index([createdAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String           @db.VarChar(30) // 'user' | 'assistant' | 'system'
  content        String           @db.Text
  /// Full AI SDK UIMessage.parts (text, tool-invocation, citations, cards)
  parts          Json?
  sequence       Int
  createdAt      DateTime         @default(now())

  // Relations
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
  @@map("chat_messages")
}

model ChatMemory {
  id             String            @id @default(cuid())
  userId         String
  conversationId String?
  category       String            @db.VarChar(50) // PREFERENCE, GOAL, HABIT, BREAKTHROUGH, FEEDBACK
  description    String            @db.Text
  importance     Int               @default(1)
  createdAt      DateTime          @default(now())

  // Relations
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, category])
  @@index([conversationId])
  @@index([importance])
  @@map("chat_memories")
}

model ChatConversationData {
  id             String           @id @default(cuid())
  conversationId String
  key            String           @db.VarChar(100)
  value          String           @db.Text
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([key])
  @@map("chat_conversation_data")
}

// Personal Access Tokens for MCP and headless agent integration
model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String    @db.VarChar(100)
  keyHash     String    @unique @db.VarChar(255)
  keyPrefix   String    @db.VarChar(16)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // The following fields are missing and commented out for future use:
  // description     String?   @db.VarChar(255)
  // scopes          String[]  @default(["notes:read", "folders:read"]) // Granular permissions matrix
  // isActive        Boolean   @default(true)
  // revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

