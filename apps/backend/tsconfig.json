{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "sourceMap": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "src/shared/types"],
    // "baseUrl": ".", // Adjust this to your source directory
    // "paths": {
    //   "*": ["node_modules/*", "src/types/*"]
    // },
    // "paths": {
    //   "@/*": ["src/*"]
    // },
    "types": ["node", "express", "multer"]
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "prisma"],
  "files": ["src/shared/types/express.d.ts"]
}
