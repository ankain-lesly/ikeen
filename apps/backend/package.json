{
  "name": "ikeen-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "build": "rimraf dist && tsc",
    "dev": "node --import=tsx --watch src/server.ts --clear-screen=false",
    "dev:ts": "node --import=tsx --watch src/server.ts",
    "dev:demo": "nodemon --watch src --exec ts-node ./src/server.ts",
    "dev:main": "cross-env NODE_ENV=development nodemon --watch src --exec ts-node ./src/server.ts --delay",
    "clean": "rimraf dist",
    "linter": "npx tsc --noEmit --project tsconfig.json",
    "lint:min": "eslint",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "*",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.3.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.9",
    "resend": "^6.28.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@repo/db": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/node-cache": "^4.2.5",
    "@types/nodemailer": "^8.0.1",
    "@types/socket.io": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0"
  }
}