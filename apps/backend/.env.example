# Server environment (copy to .env — do not commit secrets)

PORT=8383
APP_NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/iKeen_pawapay

JWT_SECRET=change-me
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d
JWT_VERIFICATION_EXPIRATION=1d
JWT_RESET_PASSWORD_EXPIRATION=10m

EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=3434
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SUPPORT=

APP_NAME=iKeen Connect
APP_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DEPLOYMENT_PLATFORM=vercel

RESEND_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_OTP_SERVICE=
TWILIO_VIRTUAL_PHONE_NUMBER=
TWILIO_PHONE_NUMBER=

INNGEST_DEV=1
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

ANTHROPIC_API_KEY=

EXPO_ACCESS_TOKEN=

# pawaPay (sandbox) — see docs/payments/pawapay-getting-started.md
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=

# Optional: enforce pawaPay callback source IPs (sandbox: 3.64.89.224)
PAWAPAY_CALLBACK_IP_VERIFY=false

# Register in pawaPay dashboard (Phase 3):
# POST {PUBLIC_API_URL}/api/v1/payments/callbacks/pawapay/deposit
# POST {PUBLIC_API_URL}/api/v1/payments/callbacks/pawapay/payout

# Database seed (Phase 0) — run: bun run db:seed
# SEED_PASSWORD=changeme-in-seed
