{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iKeen",
  "version": "0.1.0",
  "identifier": "com.techforgelee.ikeen-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iKeen Notes",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "quick-capture",
        "title": "Quick Capture",
        "width": 640,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:ikeen_desktop.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
