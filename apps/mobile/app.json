{
  "expo": {
    "name": "iKeen",
    "slug": "ikeen",
    "description": "iKeen is your personal thought partner—helping you brainstorm, organize, and connect ideas as an extension of your mind. Notes, folders, Chats, Agents and ideas are connected to your workspace.",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ikeen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004040",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#004040"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.techforgelee.ikeen"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#008040",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17bd4cd5-f0a2-4cd6-b75b-4f84d40f559c"
      }
    }
  }
}
