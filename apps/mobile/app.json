{
  "expo": {
    "name": "iKeen",
    "slug": "ikeen",
    "description": "iKeen is your personal thought partner—helping you brainstorm, organize, and connect ideas as an extension of your mind. Notes, folders, Chats, Agents and ideas are connected to your workspace.",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ikeen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "iKeen needs access to your camera to take photos and attach them directly to your notes.",
        "NSPhotoLibraryUsageDescription": "iKeen needs access to your photo library to select and attach images to your notes.",
        "NSMicrophoneUsageDescription": "iKeen needs access to your microphone to record audio notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004040",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#004040"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.techforgelee.ikeen"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "ios": {
            "AppGroup": "group.com.techforgelee.ikeen"
          },
          "android": {
            "packageNames": ["com.techforgelee.ikeen"]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The app accesses your microphone to let you record audio notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you attach images to your notes.",
          "cameraPermission": "The app accesses your camera to let you take photos directly into your notes."
        }
      ],
      "expo-image",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#004040",
          "defaultChannel": "general",
          "enableBackgroundRemoteNotifications": true,
          "sounds": ["./assets/sounds/notification.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#008040",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17bd4cd5-f0a2-4cd6-b75b-4f84d40f559c"
      }
    }
  }
}
