{
  "extends": "expo/tsconfig.base",
  "key": "value",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@repo/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@repo/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@repo/cool-package": [
        "../../packages/cool-package/index.ts"
      ],
      "@repo/cool-package/*": [
        "../../packages/cool-package/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/*/src/**/*",
    "../../packages/*/index.ts"
  ]
}
