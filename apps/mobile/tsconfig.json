{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@repo/utils": [
        "../../packages/utils/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "./src/uniwind-types.d.ts",
    "expo-env.d.ts",
    "../../packages/*/src/**/*",
    "../../packages/*/index.ts"
  ]
}
