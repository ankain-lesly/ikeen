{
  "name": "@repo/db",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports:repo:ui:test": {
    "./*": "./src/*.tsx"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./generated/prisma": {
      "types": "./generated/prisma/client.ts",
      "default": "./generated/prisma/client.ts"
    },
    "./generated/prisma/client": {
      "types": "./generated/prisma/client.ts",
      "default": "./generated/prisma/client.ts"
    },
    "./generated/prisma/enums": {
      "types": "./generated/prisma/enums.ts",
      "default": "./generated/prisma/enums.ts"
    },
    "./generated/prisma/*": {
      "types": "./generated/prisma/*.ts",
      "default": "./generated/prisma/*.ts"
    },
    "./generated/prisma/*.ts": {
      "types": "./generated/prisma/*.ts",
      "default": "./generated/prisma/*.ts"
    },
    "./generated/enums": {
      "types": "./generated/prisma/enums.ts",
      "default": "./generated/prisma/enums.ts"
    }
  },
  "devDependencies": {
    "prisma": "7.10.0"
  },
  "scripts": {
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}